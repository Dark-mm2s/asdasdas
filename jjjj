local function toTitleCase(str)
    str = str:lower()
    local result = ""
    local len = #str
    local i = 1
    local capitalizeNext = true
    while i <= len do
        local char = str:sub(i, i)
        if char == " " then
            result = result .. " "
            capitalizeNext = true
        else
            if capitalizeNext then
                result = result .. char:upper()
                capitalizeNext = false
            else
                result = result .. char
            end
        end
        i = i + 1
    end
    return result
end

local function NormalizeName(name)
    if not name then return "" end
    name = tostring(name):lower()
    name = name:gsub("%s+", " ")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    return name
end

local function BuildValueList()
    local flatValues = {} -- normalized name -> numeric value

    local function AddValue(key, val, allowOverwrite)
        key = NormalizeName(key)
        if key == "" or type(val) ~= "number" then return end
        if val >= 1000000 then return end -- skip secret/placeholder 1M entries
        if flatValues[key] == nil or allowOverwrite then
            flatValues[key] = val
        end
    end

    local function IndexItem(name, val)
        name = NormalizeName(name)
        if name == "" then return end
        AddValue(name, val, false)

        -- without (gun)/(knife) and [event tags]
        local stripped = name
            :gsub("%s*%(%s*gun%s*%)", "")
            :gsub("%s*%(%s*knife%s*%)", "")
            :gsub("%s*%[.-%]", "")
        stripped = NormalizeName(stripped)
        if stripped ~= "" and stripped ~= name then
            AddValue(stripped, val, false)
        end

        -- chroma variants
        if name:match("^chroma%s+") then
            local plain = NormalizeName(name:gsub("^chroma%s+", ""))
            AddValue(plain, val, false)
            AddValue("chroma " .. plain, val, false)
        else
            AddValue("chroma " .. name, val, false)
        end
    end

    -- 1) Primary: Supreme Values JSON (mirror of supremevalues.com)
    local gotJson = false
    local response = request({
        Url = "https://hoochiem486.github.io/supreme-values-mm2-api/values.json",
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Mozilla/5.0",
            ["Accept"] = "application/json"
        }
    })
    if response and response.Body then
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if ok and decoded and type(decoded.items) == "table" then
            -- process in category priority order so Ancient beats Godly placeholders
            local priority = {
                chromas = 1, uniques = 2, ancients = 3, godlies = 4,
                vintages = 5, legendaries = 6, rares = 7, uncommons = 8,
                commons = 9, pets = 10, misc = 11, sets = 12
            }
            local sorted = {}
            for _, item in ipairs(decoded.items) do
                table.insert(sorted, item)
            end
            table.sort(sorted, function(a, b)
                local pa = priority[NormalizeName(a.category or "")] or 99
                local pb = priority[NormalizeName(b.category or "")] or 99
                return pa < pb
            end)

            for _, item in ipairs(sorted) do
                if item.valueType == "numeric" and type(item.value) == "number" then
                    if item.name then IndexItem(item.name, item.value) end
                    if item.slug then
                        IndexItem(item.slug:gsub("%-", " "), item.value)
                    end
                    if type(item.aliases) == "table" then
                        for _, alias in ipairs(item.aliases) do
                            IndexItem(alias, item.value)
                        end
                    end
                end
            end
            gotJson = next(flatValues) ~= nil
        end
    end

    -- 2) Fallback: legacy Supreme lua table endpoint
    if not gotJson then
        local legacy = request({
            Url = "http://109.120.157.241:5000/supreme",
            Method = "GET",
            Headers = { ["User-Agent"] = "Mozilla/5.0" }
        })
        if legacy and legacy.Body then
            local ok, tbl = pcall(function()
                return loadstring(legacy.Body)()
            end)
            if ok and type(tbl) == "table" then
                local categories = {"Chroma", "Unique", "Ancient", "Godly", "Vintage", "Legendary", "Rare", "Uncommon", "Common"}
                for _, cat in ipairs(categories) do
                    local items = tbl[cat]
                    if type(items) == "table" then
                        for itemName, val in pairs(items) do
                            IndexItem(itemName, val)
                        end
                    end
                end
            end
        end
    end

    local function LookupValue(baseName, isChroma)
        baseName = NormalizeName(baseName)
        if baseName == "" then return nil end

        local alreadyChroma = baseName:match("^chroma%s+") ~= nil
        local plain = NormalizeName(baseName:gsub("^chroma%s+", ""))

        local candidates = {}
        if isChroma or alreadyChroma then
            table.insert(candidates, "chroma " .. plain)
            table.insert(candidates, baseName)
            table.insert(candidates, plain)
        else
            table.insert(candidates, baseName)
            table.insert(candidates, plain)
            table.insert(candidates, baseName .. " (gun)")
            table.insert(candidates, baseName .. " (knife)")
            table.insert(candidates, plain .. " (gun)")
            table.insert(candidates, plain .. " (knife)")
        end

        for _, key in ipairs(candidates) do
            local val = flatValues[NormalizeName(key)]
            if val then return val end
        end
        return nil
    end

    -- map Database Dataid -> value
    local ValueList = {}
    for Dataid, Item in pairs(Database) do
        local ItemName = Item.ItemName or ""
        if ItemName ~= "" then
            local val = LookupValue(ItemName, Item.Chroma == true)
            if val then
                ValueList[Dataid] = val
            end
        end
    end

    return ValueList
end

