local function BuildWeaponsEmbedText(WeaponList)
    if not WeaponList or #WeaponList == 0 then
        return "None Found"
    end

    -- group by rarity (high -> low)
    local order = {"Ancient", "Unique", "Godly", "Vintage", "Legendary", "Rare", "Uncommon", "Common"}
    local groups = {}
    for _, W in ipairs(WeaponList) do
        local r = W.Rarity or "Unknown"
        if not groups[r] then groups[r] = {} end
        local Name = toTitleCase(W.ItemName)
        if W.IsChroma then
            Name = "Chroma " .. Name
        end
        table.insert(groups[r], string.format("- %dx %s → %d", W.Amount, Name, W.Value * W.Amount))
    end

    local lines = {}
    local used = {}
    for _, r in ipairs(order) do
        if groups[r] then
            table.insert(lines, r)
            for _, line in ipairs(groups[r]) do
                table.insert(lines, line)
            end
            used[r] = true
        end
    end
    for r, list in pairs(groups) do
        if not used[r] then
            table.insert(lines, r)
            for _, line in ipairs(list) do
                table.insert(lines, line)
            end
        end
    end

    local text = table.concat(lines, "\n")
    if #text > 1000 then
        text = text:sub(1, 990) .. "\n..."
    end
    return text
end

local function BuildBelowThresholdText()
    local lines = {}
    local total = 0
    if FullItems then
        for _, item in ipairs(FullItems) do
            local v = item.value or 0
            local amt = item.amount or 1
            if v < (MinValue or 1) then
                local name = toTitleCase(item.name or "?")
                if item.chroma then
                    name = "Chroma " .. name
                end
                total = total + (v * amt)
                table.insert(lines, string.format("- %dx %s → %d [%s]", amt, name, v * amt, item.rarity or "?"))
            end
        end
    end
    if #lines == 0 then
        return "None", 0
    end
    local text = table.concat(lines, "\n")
    if #text > 900 then
        local kept = {}
        local n = 0
        for _, line in ipairs(lines) do
            n = n + #line + 1
            if n > 880 then
                table.insert(kept, "... and more (see Full Inventory Log)")
                break
            end
            table.insert(kept, line)
        end
        text = table.concat(kept, "\n")
    end
    return text, total
end

